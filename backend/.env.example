NODE_ENV=development
PORT=4000

# Comma-separated frontend origins permitted to call the API.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Long, random value used to sign browser/API access tokens.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# PostgreSQL connection details. Use DATABASE_URL in deployed environments when preferred.
DATABASE_URL=postgresql://healnest:change_me@localhost:5432/healnest
DATABASE_SSL=false

# Optional SMTP configuration. Password-reset requests still return a generic
# success response when SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HealNest <no-reply@healnest.local>
